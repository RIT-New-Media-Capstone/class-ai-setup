{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "openrouter"
  ],
  "provider": {
    "openrouter": {
      "models": {
        "@preset/light": {
          "name": "light (background)",
          "limit": {
            "context": 1048576,
            "output": 32000
          }
        },
        "@preset/ridiculous": {
          "name": "ridiculous (main)",
          "limit": {
            "context": 1048576,
            "output": 32000
          }
        },
        "@preset/ludicrous": {
          "name": "ludicrous (planning)",
          "limit": {
            "context": 1048576,
            "output": 32000
          }
        },
        "@preset/plaid": {
          "name": "plaid (top rung)",
          "limit": {
            "context": 1048576,
            "output": 32000
          }
        }
      },
      "whitelist": [
        "@preset/light",
        "@preset/ridiculous",
        "@preset/ludicrous",
        "@preset/plaid"
      ]
    }
  },
  "model": "openrouter/@preset/ridiculous",
  "small_model": "openrouter/@preset/light",
  "agent": {
    "plan": {
      "model": "openrouter/@preset/ludicrous"
    }
  },
  "permission": {
    "bash": "ask"
  }
}
