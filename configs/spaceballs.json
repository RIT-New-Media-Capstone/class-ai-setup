{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "class": {
      "name": "Class",
      "package": "@opencode/ai/providers/openrouter",
      "models": {
        "@preset/light": {
          "name": "light (background)",
          "limit": {
            "context": 1048576,
            "output": 32000
          }
        },
        "@preset/ridiculous": {
          "name": "ridiculous (main)",
          "limit": {
            "context": 1048576,
            "output": 32000
          }
        },
        "@preset/ludicrous": {
          "name": "ludicrous (planning)",
          "limit": {
            "context": 1048576,
            "output": 32000
          }
        },
        "@preset/plaid": {
          "name": "plaid (top rung)",
          "limit": {
            "context": 1048576,
            "output": 32000
          }
        }
      }
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "class",
      "effect": "allow"
    }
  ],
  "model": "class/@preset/ridiculous",
  "agents": {
    "title": {
      "model": "class/@preset/light"
    },
    "plan": {
      "model": "class/@preset/ludicrous"
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
