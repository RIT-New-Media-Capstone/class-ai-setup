{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "openrouter"
  ],
  "provider": {
    "openrouter": {
      "models": {
        "@preset/freedom": {
          "name": "freedom (background)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "@preset/liberty": {
          "name": "liberty (main)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "@preset/liberty-plus": {
          "name": "liberty-plus (planning)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "@preset/freedom-max-20x": {
          "name": "freedom-max-20x (top rung)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        }
      },
      "whitelist": [
        "@preset/freedom",
        "@preset/liberty",
        "@preset/liberty-plus",
        "@preset/freedom-max-20x"
      ]
    }
  },
  "model": "openrouter/@preset/liberty",
  "small_model": "openrouter/@preset/freedom",
  "agent": {
    "plan": {
      "model": "openrouter/@preset/liberty-plus"
    }
  }
}
