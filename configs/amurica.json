{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "class"
  ],
  "provider": {
    "class": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (class)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "@preset/freedom": {
          "name": "freedom (background)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "@preset/liberty": {
          "name": "liberty (main)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "@preset/liberty-plus": {
          "name": "liberty-plus (planning)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "@preset/freedom-max-20x": {
          "name": "freedom-max-20x (top rung)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        }
      }
    }
  },
  "model": "class/@preset/liberty",
  "small_model": "class/@preset/freedom",
  "agent": {
    "plan": {
      "model": "class/@preset/liberty-plus"
    }
  }
}
