{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "class": {
      "name": "Class",
      "package": "@opencode/ai/providers/openrouter",
      "compatibility": {
        "cacheFormat": "anthropic"
      },
      "models": {
        "@preset/freedom": {
          "name": "freedom (background)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "@preset/liberty": {
          "name": "liberty (main)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "@preset/liberty-plus": {
          "name": "liberty-plus (planning)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "@preset/freedom-max-20x": {
          "name": "freedom-max-20x (top rung)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        }
      }
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "class",
      "effect": "allow"
    }
  ],
  "model": "class/@preset/liberty",
  "agents": {
    "title": {
      "model": "class/@preset/freedom"
    },
    "plan": {
      "model": "class/@preset/liberty-plus"
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
